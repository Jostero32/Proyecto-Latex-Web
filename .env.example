# Infraestructura (docker compose) — credenciales solo para desarrollo
POSTGRES_USER=latexweb
POSTGRES_PASSWORD=latexweb
POSTGRES_DB=latexweb
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=latexweb
MINIO_ROOT_PASSWORD=latexweb-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Apps
# Las apps leen process.env (no cargan .env por sí mismas: no usamos dotenv). Todas las variables
# tienen un valor por defecto; definirlas solo para cambiarlo.
# apps/server: API REST en http://127.0.0.1:$SERVER_PORT y colaboración en ws://127.0.0.1:$SERVER_PORT/collab
SERVER_PORT=3000
REDIS_URL=redis://127.0.0.1:6379

# Compilación (docs/specs/compilacion.md). COMPILE_STORAGE_DIR tiene que ser la misma ruta absoluta
# para apps/server y apps/compiler; por defecto, <directorio temporal del sistema>/latexweb-compilations.
# Sin comas: rompen la sintaxis de `docker run --mount`.
# COMPILE_STORAGE_DIR=
COMPILE_IMAGE=latexweb-texlive:tl2026-1
COMPILE_TIMEOUT_SECONDS=60
COMPILE_MEMORY=1g
COMPILE_CPUS=1
COMPILE_PIDS_LIMIT=128
COMPILE_TMPFS_SIZE=256m
COMPILE_CONCURRENCY=2
COMPILE_TTL_SECONDS=3600
COMPILE_MAX_QUEUED=50
COMPILE_MAX_PDF_BYTES=52428800
COMPILE_MAX_LOG_BYTES=5242880
# Límites de subida (POST /compilations)
COMPILE_MAX_UPLOAD_FILE_BYTES=20971520
COMPILE_MAX_UPLOAD_TOTAL_BYTES=52428800
COMPILE_MAX_UPLOAD_FILES=200
