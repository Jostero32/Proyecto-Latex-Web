# Infraestructura (docker compose) — credenciales solo para desarrollo
# Puertos del host poco comunes (5xxxx) para no chocar con otros proyectos; dentro de compose, los de siempre.
POSTGRES_USER=latexweb
POSTGRES_PASSWORD=latexweb
POSTGRES_DB=latexweb
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_ROOT_USER=latexweb
MINIO_ROOT_PASSWORD=latexweb-dev-secret
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001

# Apps
# `pnpm dev` carga este .env (node --env-file-if-exists). Todas las variables tienen un valor por
# defecto; definirlas solo para cambiarlo.
# server: API REST en http://127.0.0.1:$SERVER_PORT/api y colaboración en ws://127.0.0.1:$SERVER_PORT/collab
SERVER_PORT=53000
REDIS_URL=redis://127.0.0.1:56379

# Compilación (docs/specs/backend.md, paso 4). Server y compiler se comunican por Redis y MinIO.
# COMPILE_WORK_DIR: disco de trabajo del worker; por defecto, <directorio temporal>/latexweb-compile-work.
# Sin comas: rompen la sintaxis de `docker run --mount`.
# COMPILE_WORK_DIR=
COMPILE_IMAGE=latexweb-texlive:tl2026-2
COMPILE_TIMEOUT_SECONDS=60
COMPILE_MEMORY=1g
COMPILE_CPUS=1
COMPILE_PIDS_LIMIT=128
COMPILE_TMPFS_SIZE=256m
COMPILE_CONCURRENCY=2
# Cuánto se conservan el estado y los artefactos (MinIO los borra a 1 día).
COMPILE_TTL_SECONDS=86400
COMPILE_MAX_QUEUED=50
COMPILE_MAX_PDF_BYTES=52428800
COMPILE_MAX_LOG_BYTES=5242880
# Para `docker compose up -d --build` (ver docs/specs/docker-compose.md): compose ya define
# SERVER_HOST=0.0.0.0 y COMPILE_WORK_VOLUME=latexweb-compile-work dentro de los contenedores.
# WEB_PORT=55173
# SERVER_HOST=127.0.0.1
# COMPILE_WORK_VOLUME=
# Con menos espacio libre en el disco de trabajo, el worker no compila.
COMPILE_MIN_FREE_BYTES=1073741824

# Protecciones del servidor
# Orígenes web que pueden usar la API y /collab desde un navegador (separados por comas).
ALLOWED_ORIGINS=http://127.0.0.1:55173,http://localhost:55173
# Nombres de host aceptados en la cabecera Host (contra DNS rebinding).
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
SERVER_REQUEST_TIMEOUT_MS=120000
# Swagger UI en /api/docs (false para apagarlo).
API_DOCS=true

# Proyectos (docs/specs/backend.md): binarios en MinIO y topes por proyecto.
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY=latexweb
S3_SECRET_KEY=latexweb-dev-secret
S3_BUCKET=latexweb
# S3_REGION=us-east-1
PROJECT_MAX_BYTES=209715200
PROJECT_MAX_FILES=500
FILE_MAX_BYTES=52428800
# Tope del texto de un proyecto (el documento de colaboración vive en memoria mientras se edita).
DOC_MAX_BYTES=10485760

# Base de datos y auth (docs/specs/auth.md)
DATABASE_URL=postgresql://latexweb:latexweb@127.0.0.1:55432/latexweb
# true en producción (HTTPS); con false la cookie de sesión viaja también por http.
COOKIE_SECURE=false
