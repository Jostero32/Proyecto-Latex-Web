// Modelo de datos de apps/server. Ver docs/specs/auth.md.
// Migraciones: `pnpm --filter @latexweb/server db:migrate` (desarrollo) y `db:deploy` (aplicar).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// En minúsculas y sin espacios (normalizeEmail).
  email        String    @unique
  name         String?
  /// argon2id (formato PHC).
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  /// sha256 (hex) del token de la cookie: el token nunca se guarda.
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}
